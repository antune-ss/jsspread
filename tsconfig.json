{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],

    "types": ["google-apps-script"], 

    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    
    "useDefineForClassFields": false,
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./src/*"],
      "@lib/*": ["./lib/*"]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
